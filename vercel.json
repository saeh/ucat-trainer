{
  "installCommand": "npm install",
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/__clerk/:path*",
      "destination": "https://cdn.jsdelivr.net/npm/@clerk/clerk-js@6/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
